<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeAgentDashboard.Presentation.Views.AgentActivityDetailView"
        Title="Agent Activity"
        Width="360" Height="180"
        CanResize="False">
  <StackPanel Margin="16" Spacing="8">
    <TextBlock Name="AgentLabelText" FontWeight="Bold" FontSize="16" TextWrapping="Wrap" />
    <TextBlock Name="ActivityStateText" Opacity="0.7" />
    <TextBlock Name="ActivitySummaryText" TextWrapping="Wrap" />
  </StackPanel>
</Window>
