<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClaudeAgentDashboard.Presentation.Views.AgentCardView"
             Width="152" Height="112">
  <UserControl.Styles>
    <Style Selector="Border#CardChrome:pointerover">
      <Setter Property="BorderBrush" Value="#59FFFFFF" />
      <Setter Property="RenderTransform" Value="scale(1.03)" />
    </Style>
  </UserControl.Styles>
  <Border Name="CardChrome"
          CornerRadius="14"
          BorderThickness="1"
          BorderBrush="#40FFFFFF"
          BoxShadow="0 8 20 -6 #CC000000"
          RenderTransformOrigin="0.5,0.5"
          Margin="6">
    <!-- Margin leaves room inside the UserControl's fixed 152x112 bounds for the
         pointer-over scale(1.03) below to grow into without its corners being
         clipped by the parent canvas/scroll viewport. -->

    <Border.Transitions>
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:00:00.12" />
        <BrushTransition Property="BorderBrush" Duration="0:00:00.12" />
      </Transitions>
    </Border.Transitions>
    <Border.Background>
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="#8C1A1A1E" Offset="0" />
        <GradientStop Color="#B3101013" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid RowDefinitions="Auto,*,Auto" Margin="14">
      <Ellipse Name="StatusDot" Grid.Row="0" Width="10" Height="10"
                HorizontalAlignment="Left" Fill="Gray" />
      <TextBlock Name="LabelText" Grid.Row="1" VerticalAlignment="Center"
                 FontWeight="SemiBold" FontSize="13.5" Foreground="White"
                 TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxLines="2"
                 Margin="0,6,0,6" />
      <Border Name="StatusBadge" Grid.Row="2" HorizontalAlignment="Left"
              CornerRadius="7" Padding="7,2">
        <TextBlock Name="StatusText" FontSize="10.5" FontWeight="Medium" />
      </Border>
    </Grid>
  </Border>
</UserControl>
