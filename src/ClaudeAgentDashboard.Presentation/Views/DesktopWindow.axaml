<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ClaudeAgentDashboard.Presentation.Views.DesktopWindow"
        Title="Claude Agent Dashboard — Command Center"
        Width="960" Height="640"
        Background="{DynamicResource CcBackgroundBrush}">

  <!--
    Command-center visual theme (FR-013): the actual palette (dark/light) lives in
    App.axaml/Theming.ThemeResources, shared by every window and child view via Avalonia's
    up-the-tree DynamicResource lookup — this window only consumes it, it doesn't own it, so
    a sibling window (SettingsWindow) can use the exact same palette. Per-status colors
    (working/idle/waiting/ended) stay in ActivityPresentation.cs, unchanged from 001.
  -->

  <Grid>
    <Grid RowDefinitions="Auto,*" Margin="16">
      <ContentControl Name="SummaryPanelHost" Grid.Row="0" Margin="0,0,0,12" />
      <ContentControl Name="TableHost" Grid.Row="1" />
    </Grid>

    <Border Name="OverlayScrim" Background="{DynamicResource CcScrimBrush}" IsVisible="False">
      <ContentControl Name="OverlayHost" />
    </Border>
  </Grid>
</Window>
