<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:ClaudeAgentDashboard.Presentation.Views"
        x:Class="ClaudeAgentDashboard.Presentation.Views.AgentListWindow"
        Title="Claude Agent Dashboard"
        Width="420" Height="480">
  <DockPanel>
    <TextBlock Name="MessageBanner"
               DockPanel.Dock="Bottom"
               Padding="8"
               Background="#33FF9800"
               TextWrapping="Wrap"
               IsVisible="False" />
    <Grid>
      <TextBlock Name="EmptyStateText"
                 Text="No Claude Code agents detected."
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="False" />
      <ScrollViewer>
        <ItemsControl Name="AgentItems">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="views:AgentListItem">
              <Border Padding="8" BorderThickness="0,0,0,1" BorderBrush="#33000000">
                <Grid ColumnDefinitions="*,Auto,Auto">
                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Label}" FontWeight="Bold" />
                    <TextBlock Text="{Binding StatusText}" Opacity="0.7" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Show" Tag="{Binding Session}" Click="OnShowClicked" />
                  <Button Grid.Column="2" Content="Dismiss" Margin="4,0,0,0" Tag="{Binding Session}"
                          IsVisible="{Binding IsEnded}" Click="OnDismissClicked" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
