<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ClaudeAgentDashboard.Presentation.Views.AgentDetailOverlay">
  <UserControl.Styles>
    <!-- research.md R6: toggling OverlayChrome between these two classes is the whole
         standard <-> full-window expand/restore mechanism (FR-011/FR-012) — no second
         window, no separate view, just a size/alignment swap on the same control. -->
    <Style Selector="Border.standard">
      <Setter Property="Width" Value="420" />
      <Setter Property="MaxHeight" Value="520" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.expanded">
      <Setter Property="Width" Value="NaN" />
      <Setter Property="MaxHeight" Value="NaN" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
  </UserControl.Styles>
  <Border Name="OverlayChrome" Classes="standard"
          CornerRadius="16" Padding="20"
          BorderThickness="1" BorderBrush="{DynamicResource CcOverlayBorderBrush}"
          Background="{DynamicResource CcOverlayBackgroundBrush}"
          BoxShadow="0 16 40 -10 #AA000000">
    <DockPanel>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto">
        <TextBlock Name="AgentLabelText" Grid.Column="0" FontWeight="SemiBold" FontSize="15"
                   Foreground="{DynamicResource CcTextBrush}" TextWrapping="Wrap" />
        <Button Name="ExpandToggleButton" Grid.Column="1" Content="⤢" Click="OnExpandToggleClicked"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource CcMutedTextBrush}"
                CornerRadius="6" Padding="6,2" Margin="0,0,4,0" />
        <Button Grid.Column="2" Content="✕" Click="OnCloseClicked"
                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource CcMutedTextBrush}"
                CornerRadius="6" Padding="6,2" />
      </Grid>
      <TextBlock Name="MessageBanner" DockPanel.Dock="Bottom" Foreground="#FFC46B"
                 TextWrapping="Wrap" IsVisible="False" Margin="0,10,0,0" FontSize="12.5" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" Margin="0,16,0,0">
        <Button Name="ShowButton" Content="Show" Click="OnShowClicked"
                Background="#3D7CFF" Foreground="White" CornerRadius="8" Padding="16,7" />
        <Button Name="DismissButton" Content="Dismiss" Click="OnDismissClicked" IsVisible="False"
                Background="{DynamicResource CcSubtleFillBrush}" Foreground="{DynamicResource CcTextBrush}"
                CornerRadius="8" Padding="16,7" />
      </StackPanel>
      <Grid RowDefinitions="Auto,*" Margin="0,16,0,0">
        <StackPanel Grid.Row="0" Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Border Name="ActivityBadge" HorizontalAlignment="Left" CornerRadius="8" Padding="9,3">
              <TextBlock Name="ActivityStateText" FontSize="12" FontWeight="Medium" />
            </Border>
            <Border Name="ModeBadge" HorizontalAlignment="Left" CornerRadius="8" Padding="9,3">
              <TextBlock Name="ModeStateText" FontSize="12" FontWeight="Medium" />
            </Border>
          </StackPanel>
          <TextBlock Name="ActivitySummaryText" Foreground="{DynamicResource CcTextBrush}" TextWrapping="Wrap" FontSize="13" />
          <Border Name="HookSetupPanel" IsVisible="False" Background="{DynamicResource CcSubtleFillBrush}" CornerRadius="8"
                  Padding="12" Margin="0,4,0,0">
            <StackPanel Spacing="8">
              <TextBlock Name="HookSetupExplanationText" Foreground="{DynamicResource CcMutedTextBrush}" TextWrapping="Wrap"
                         FontSize="12" />
              <Button Name="SetUpHooksButton" Content="Set up activity detection…"
                      Click="OnSetUpHooksClicked" HorizontalAlignment="Left"
                      Background="{DynamicResource CcSubtleFillBrush}" Foreground="{DynamicResource CcTextBrush}"
                      CornerRadius="7" Padding="12,6" FontSize="12.5" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Grid Name="TranscriptSection" Grid.Row="1" IsVisible="False" RowDefinitions="Auto,*" Margin="0,10,0,0" MinHeight="0">
          <!-- A ScrollViewer directly inside a StackPanel is offered unbounded height along
               the stack axis and just grows to fit all content instead of clipping/scrolling
               (confirmed by real rendering: bubbles overflowed past the card into the Show
               button below) — a Grid "*" row genuinely bounds it, so scrolling actually works. -->
          <TextBlock Grid.Row="0" Text="Recent conversation" Foreground="{DynamicResource CcMutedTextBrush}" FontSize="11"
                     FontWeight="Medium" Margin="0,0,0,6" />
          <ScrollViewer Name="TranscriptScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Name="TranscriptItems" Spacing="8" Margin="0,0,4,4" />
          </ScrollViewer>
        </Grid>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
